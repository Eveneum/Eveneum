<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>Eveneum.NewtonsoftJson</id>
		    <version>#{GitVersion.FullSemVer}#</version>
		    <authors>Jakub Konecki</authors>
        <owners>Jakub Konecki</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Newtonsoft Json.NET serializer for Eveneum event store.</description>
        <projectUrl>https://github.com/Eveneum/Eveneum</projectUrl>
        <license type="expression">MIT</license>
        <tags>event-sourcing event-store cosmosdb</tags>
        <dependencies>
          <group targetFramework=".NETStandard2.0">
            <dependency id="Eveneum" version="[#{GitVersion.FullSemVer}#]" />
            <dependency id="Newtonsoft.Json" version="13.0.4" />
          </group>
        </dependencies>
    </metadata>
    <files>
		<file src="bin\Release\**\Eveneum.NewtonsoftJson.dll" target="lib" />
		<file src="bin\Release\**\Eveneum.NewtonsoftJson.pdb" target="lib" />
	</files>
</package>